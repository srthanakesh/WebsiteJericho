# Copy this file to assistant/.env and fill in your real keys. Never commit .env.

# GLM (Zhipu) API
GLM_API_KEY=your-glm-api-key-here
# Use https://api.z.ai/api/paas/v4 if your key is from z.ai (international)
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_VISION_MODEL=glm-4v-plus
GLM_CHAT_MODEL=glm-4-plus

# Fish Audio TTS
FISH_API_KEY=your-fish-audio-api-key-here
# Reference ID of the "Sarah" voice model (copy it from the voice's page on fish.audio)
FISH_VOICE_ID=your-sarah-voice-reference-id
FISH_TTS_MODEL=s2.1-pro-free
